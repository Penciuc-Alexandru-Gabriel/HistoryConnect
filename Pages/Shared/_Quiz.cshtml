@model HistoryConnect.Pages.IndexModel

@{
    var lectie = Model.LectieActiva;
}

@if (lectie == null)
{
    <div class="flex flex-col items-center justify-center py-16 text-center max-w-[500px] mx-auto">
        <span class="text-5xl mb-4">📝</span>
        <p style="color:#a07050;">Selectează o lecție pentru a vedea quiz-ul asociat.</p>
    </div>
}
else if (lectie.Quizuri == null || !lectie.Quizuri.Any())
{
    <div class="flex flex-col items-center justify-center py-16 text-center max-w-[500px] mx-auto">
        <span class="text-5xl mb-4">🔍</span>
        <p style="color:#a07050;">Această lecție nu are un quiz asociat încă.</p>
    </div>
}
else
{
    var primuLQuiz = lectie.Quizuri.OrderBy(q => q.IdQuiz).First();

    <div class="flex flex-col items-center justify-center py-[60px] px-5 text-center">
        <div class="rounded-[16px] p-[48px_40px] max-w-[500px] w-full shadow-[0_8px_32px_rgba(0,0,0,.5)]"
             style="background:rgba(20,8,0,0.85); border:1px solid rgba(200,100,0,0.35);">

            <div class="text-5xl mb-4">🎯</div>

            <h3 class="font-bold mb-3"
                style="font-family:'Cinzel',serif; color:#f5d78e; font-size:1.4rem;">
                @primuLQuiz.Titlu
            </h3>

            <p class="mb-6 text-[.95rem]" style="color:#a07050;">
                Ai terminat lecția? Testează-ți cunoștințele!
            </p>

            <div class="flex justify-center gap-4 flex-wrap mb-7">
                @if (primuLQuiz.Timp > 0)
                {
                    <span class="px-[14px] py-[5px] rounded-[20px] text-[.85rem] font-semibold"
                          style="background:rgba(255,100,0,.15); color:#ff9955; border:1px solid rgba(255,100,0,.25);">
                        ⏱ @primuLQuiz.Timp secunde
                    </span>
                }
                @if (primuLQuiz.XpCompletare > 0)
                {
                    <span class="px-[14px] py-[5px] rounded-[20px] text-[.85rem] font-semibold"
                          style="background:rgba(255,180,0,.15); color:#ffd060; border:1px solid rgba(255,180,0,.25);">
                        ⭐ +@primuLQuiz.XpCompletare XP
                    </span>
                }
                <span class="px-[14px] py-[5px] rounded-[20px] text-[.85rem]"
                      style="background:rgba(255,255,255,.05); color:#a07050; border:1px solid rgba(255,255,255,.1);">
                    📋 @(primuLQuiz.Intrebari?.Count() ?? 0) intrebari
                </span>
            </div>

            <a href="/Quiz/Quiz?quizId=@primuLQuiz.IdQuiz"
               class="inline-block py-3 px-9 rounded-lg no-underline text-base transition-opacity duration-200 hover:opacity-85"
               style="background:linear-gradient(135deg,#c84800,#8b2000); color:#f5d78e; font-family:'Georgia',serif;">
                Începe Quiz-ul →
            </a>

        </div>
    </div>
}
