<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HistoryConnect</title>

    @* Tailwind CSS compilat (v4) — generat cu `npm run build:css` *@
    <link rel="stylesheet" href="~/css/site-tailwind.css" asp-append-version="true" />

    @* Google Fonts *@
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet">
    
    @* CSS-ul custom al aplicatiei (tema medievala, header, lectii etc.) *@
    @await Html.PartialAsync("_HistoryStyles")
</head>

<body class="@ViewData["BodyClass"]">
    
    @* Header-ul se randeaza O SINGURA DATA aici *@
    @await Html.PartialAsync("_Header")

    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
